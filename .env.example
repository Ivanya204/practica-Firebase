# ============================================================================
# .env.example
# ----------------------------------------------------------------------------
# Este archivo es una PLANTILLA. Muestra qué variables de entorno necesita
# el proyecto para conectarse a Firebase, pero SIN valores reales.
#
# Cómo usarlo:
#   1. Copiá este archivo y renombrá la copia a ".env" (sin ".example").
#   2. Completá cada variable con los datos de TU propio proyecto de
#      Firebase (Firebase Console > Configuración del proyecto > Tus apps).
#   3. El archivo ".env" NUNCA se sube a GitHub (está en .gitignore), así
#      que tus credenciales quedan solo en tu computadora.
# ============================================================================

API_KEY=
AUTH_DOMAIN=
PROJECT_ID=
STORAGE_BUCKET=
MESSAGING_SENDER_ID=
APP_ID=
