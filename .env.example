# Plantilla de variables de entorno. Copiá este archivo como ".env" y
# completá cada valor con los datos de tu propio proyecto de Firebase
# (Firebase Console > Configuración del proyecto > Tus apps).
# El .env real nunca se sube a GitHub, está en .gitignore.

API_KEY=
AUTH_DOMAIN=
PROJECT_ID=
STORAGE_BUCKET=
MESSAGING_SENDER_ID=
APP_ID=
